{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "olivia-tournai",
  "compatibility_date": "2026-11-17",
  "observability": {
    "enabled": true
  },
  // Static site only: dist/ is built by `npm run build`; _headers sets cache and security headers.
  "assets": {
    "directory": "dist",
    "not_found_handling": "404-page"
  }
}
